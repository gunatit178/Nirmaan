# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real credentials.

# Required to run any agent against the real Anthropic provider
# (npm run demo:pm, or any future API route that calls runAgent()).
# Not required to run the plumbing test suite (npm test) — that uses a
# mock provider and never makes a network call.
ANTHROPIC_API_KEY=
