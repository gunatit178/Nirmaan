// Data model per /docs/architecture-plan.md Section E.
//
// SQLite for now (Phase 3 — zero infra, single-founder scale). See the
// architecture plan's Technology Decisions for the migration trigger to
// Postgres. Two SQLite-specific simplifications, both called out inline:
//   - No native enum type: status/stage/gate fields are plain String
//     columns. The allowed values are enforced in the TypeScript layer
//     (src/lib/db/enums.ts), not the database.
//   - No native scalar list type: list fields (dependencies, blockers,
//     assumptions, tags, ...) are stored as JSON-encoded TEXT and
//     parsed/serialized in application code (src/lib/db/json.ts).
//
// Artifact CONTENT is never stored here — only a pointer (filePath) into
// /projects/{id}/... on disk. That's the whole point of the file-based
// artifact convention (versioning for free via git).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Client {
  id        String    @id @default(cuid())
  name      String
  contact   String? // free-text for now; not enough client volume yet to justify structured fields
  email     String? // primary contact email (Phase 1: taken from the lead that converted)
  company   String?
  projects  Project[]
  leads     Lead[]
  createdAt DateTime  @default(now())
}

model Project {
  id              String          @id @default(cuid())
  // Human-readable id, e.g. PRJ-003 (see src/lib/ids.ts). Nullable only
  // because projects created before Phase 1 have none.
  code            String?         @unique
  name            String
  clientId        String?
  client          Client?         @relation(fields: [clientId], references: [id])
  // LEAD|DISCOVERY|REQUIREMENTS|ESTIMATION|PROPOSAL|APPROVED|PLANNING|
  // DESIGN|ARCHITECTURE|IMPLEMENTATION|QA|SECURITY_REVIEW|DEPLOYMENT|
  // MONITORING|MAINTENANCE — see src/lib/db/enums.ts#PROJECT_STAGES
  stage           String          @default("LEAD")
  // Directory name under /projects/ at the repo root, e.g. "demo-project"
  artifactsPath   String
  tasks           Task[]
  artifacts       Artifact[]
  approvals       Approval[]
  events          Event[]
  deployments     Deployment[]
  knowledge       Knowledge[]
  // Phase 1 business links
  leadId          String?
  lead            Lead?           @relation(fields: [leadId], references: [id])
  proposalId      String?         @unique
  proposal        Proposal?       @relation("ProjectProposal", fields: [proposalId], references: [id])
  // sha256 of the client status-page token (/status/<token>); raw token is
  // shown once and never stored.
  statusTokenHash String?         @unique
  requirements    Requirement[]
  features        Feature[]
  testCases       TestCase[]
  changeRequests  ChangeRequest[]
  // Phase 2: AI software factory
  agentRuns       AgentRun[]
  // Spend cap for automated agent work on this project (USD). Null = no automated dispatch.
  aiBudgetUsd     Float?
  // sha256 of the CI token allowed to post test evidence (/api/ci/evidence)
  ciTokenHash     String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Task {
  id           String     @id @default(cuid())
  code         String?    @unique // TASK-042
  title        String
  description  String?
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id])
  ownerAgent   String? // agent slug, matches /agents/<slug>
  // BACKLOG|READY|IN_PROGRESS|BLOCKED|REVIEW|APPROVED|DONE
  status       String     @default("BACKLOG")
  // LOW|MEDIUM|HIGH
  priority     String     @default("MEDIUM")
  dependencies String     @default("[]") // JSON array of Task ids
  estimate     String?
  actual       String?
  blockers     String     @default("[]") // JSON array of strings
  artifacts    Artifact[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Agent {
  id          String       @id @default(cuid())
  slug        String       @unique // matches /agents/<slug>/agent.md
  role        String
  // ACTIVE|DRAFT|DISABLED
  status      String       @default("DRAFT")
  permissions String       @default("{}") // JSON-encoded AgentPermissions
  artifacts   Artifact[]
  evaluations Evaluation[]
  createdAt   DateTime     @default(now())
}

model Artifact {
  id               String       @id @default(cuid())
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id])
  taskId           String?
  task             Task?        @relation(fields: [taskId], references: [id])
  // PRD|ADR|UX_SPEC|DESIGN_SPEC|API_SPEC|SCHEMA|TEST_REPORT|SECURITY_REPORT|
  // DEPLOYMENT_PLAN|... — open-ended by design, agents keep adding types
  type             String
  // Path relative to /projects/{projectId}/, e.g. "requirements/prd.md".
  // Content lives on disk, never duplicated here.
  filePath         String
  version          Int          @default(1)
  createdByAgentId String?
  createdByAgent   Agent?       @relation(fields: [createdByAgentId], references: [id])
  deployments      Deployment[]
  createdAt        DateTime     @default(now())
}

model Approval {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  // REQUIREMENTS|DESIGN|ARCHITECTURE|IMPLEMENTATION|QA|PRODUCTION — see src/lib/db/enums.ts#APPROVAL_GATES
  gate        String
  // PENDING|APPROVED|REJECTED
  status      String    @default("PENDING")
  requestedBy String // agent slug, or "human"
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Event {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  agentSlug String?
  taskId    String?
  message   String
  timestamp DateTime @default(now())
}

model Knowledge {
  id        String   @id @default(cuid())
  // GLOBAL|PROJECT|AGENT
  scope     String
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  agentSlug String?
  title     String
  content   String
  tags      String   @default("[]") // JSON array of strings
  createdAt DateTime @default(now())
}

model Evaluation {
  id              String   @id @default(cuid())
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id])
  testCase        String
  expectedOutcome String
  actualOutcome   String?
  passed          Boolean?
  runAt           DateTime @default(now())
}

model Deployment {
  id           String    @id @default(cuid())
  code         String?   @unique // DEPLOY-012
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id])
  environment  String // e.g. "production", "staging"
  // PENDING|IN_PROGRESS|SUCCEEDED|FAILED|ROLLED_BACK
  status       String    @default("PENDING")
  deployedAt   DateTime?
  rollbackPlan String?
  artifactId   String?
  artifact     Artifact? @relation(fields: [artifactId], references: [id])
}

// ---------------------------------------------------------------------
// Phase 1: Business OS (see /docs/strategy/roadmap.md)
// Money is stored as whole Indian rupees (Int). Allowed string values are
// enforced in src/lib/db/enums.ts, as for every other status column here.
// ---------------------------------------------------------------------

// Internal team member. Clients do not have accounts in Phase 1; they act
// through capability links (see Proposal.shareTokenHash, Project.statusTokenHash).
model User {
  id           String    @id @default(cuid())
  email        String    @unique // stored lower-cased
  name         String
  // FOUNDER|CTO|PROJECT_MANAGER|ENGINEER|DESIGNER|QA|FINANCE|SUPPORT
  role         String
  passwordHash String // scrypt, see src/lib/auth/password.ts
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  sessions     Session[]
  createdAt    DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  // sha256 of the cookie value; the raw token only ever lives in the cookie
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Security-relevant actions across the whole system (who did what to which
// object). Distinct from Event, which is a per-project activity feed.
model AuditLog {
  id         String   @id @default(cuid())
  // USER|CLIENT_LINK|SYSTEM|AGENT|PUBLIC
  actorType  String
  actorId    String? // user id, agent slug, or null
  actorLabel String // human-readable, e.g. "Om Patel" or "Client via proposal link"
  action     String // e.g. "proposal.sent", "lead.status_changed"
  entityType String
  entityId   String
  detail     String? // redacted free text
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// Atomic per-prefix counters behind human-readable ids (REQ-104).
model Counter {
  key   String @id
  value Int    @default(0)
}

model Lead {
  id              String          @id @default(cuid())
  code            String          @unique // LEAD-001
  // NEW|DISCOVERY|QUALIFIED|PROPOSAL|WON|LOST|SPAM
  status          String          @default("NEW")
  // WEBSITE|MANUAL|REFERRAL
  source          String          @default("WEBSITE")
  // The customer's own words. Never rewritten; discovery works from it.
  problem         String
  business        String?
  currentSolution String?
  affected        String?
  frequency       String?
  scale           String?
  existingSystems String?
  desiredOutcome  String?
  budgetRange     String?
  timeline        String?
  urgency         String?
  contactName     String
  contactEmail    String
  contactPhone    String?
  company         String?
  lostReason      String?
  ownerId         String?
  clientId        String?
  client          Client?         @relation(fields: [clientId], references: [id])
  discovery       DiscoveryItem[]
  requirements    Requirement[]
  proposals       Proposal[]
  projects        Project[]
  notes           LeadNote[]
  lastActivityAt  DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    String
  body      String
  createdAt DateTime @default(now())
}

// Discovery output, kept strictly typed so a guess can never silently
// become a requirement (see src/lib/discovery/items.ts#promoteToRequirement).
model DiscoveryItem {
  id          String       @id @default(cuid())
  leadId      String
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // FACT|ASSUMPTION|QUESTION|RECOMMENDATION
  kind        String
  text        String
  // CLIENT|AGENT|TEAM
  source      String
  // OPEN|CONFIRMED|REJECTED|ANSWERED
  status      String       @default("OPEN")
  answer      String?
  // Which agent run produced it (AiUsage.id), if any
  aiUsageId   String?
  requirement Requirement?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Requirement {
  id                 String         @id @default(cuid())
  code               String         @unique // REQ-104
  leadId             String?
  lead               Lead?          @relation(fields: [leadId], references: [id])
  projectId          String?
  project            Project?       @relation(fields: [projectId], references: [id])
  // BUSINESS|FUNCTIONAL|NON_FUNCTIONAL|CONSTRAINT
  kind               String
  statement          String
  acceptanceCriteria String         @default("[]") // JSON list of strings
  // MUST|SHOULD|COULD|WONT
  priority           String         @default("MUST")
  // DRAFT|APPROVED|CHANGED|DROPPED
  status             String         @default("DRAFT")
  sourceItemId       String?        @unique
  sourceItem         DiscoveryItem? @relation(fields: [sourceItemId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Feature {
  id          String   @id @default(cuid())
  code        String   @unique // FEAT-027
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  title       String
  description String?
  // PLANNED|IN_PROGRESS|DONE
  status      String   @default("PLANNED")
  createdAt   DateTime @default(now())
}

model TestCase {
  id        String     @id @default(cuid())
  code      String     @unique // TEST-031
  projectId String
  project   Project    @relation(fields: [projectId], references: [id])
  title     String
  // STATIC|UNIT|INTEGRATION|E2E|SECURITY|PERFORMANCE|SMOKE|QA
  level     String
  evidence  Evidence[]
  createdAt DateTime   @default(now())
}

// Proof, not claims: "14/14 unit tests passed", recorded against a test case.
model Evidence {
  id         String   @id @default(cuid())
  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  // PASS|FAIL
  result     String
  passed     Int      @default(0)
  total      Int      @default(0)
  summary    String
  link       String? // CI run, report, screenshot
  // MANUAL | CI. For CI, runRef makes re-posting the same run idempotent.
  source     String   @default("MANUAL")
  runRef     String?
  recordedBy String
  recordedAt DateTime @default(now())

  @@unique([testCaseId, runRef])
}

// Edges of the project knowledge graph. Nodes are addressed by their
// human-readable code (REQ-104 -> FEAT-027), which is stable and unique
// across every table.
model TraceLink {
  id        String   @id @default(cuid())
  projectId String
  fromCode  String
  toCode    String
  // SATISFIED_BY (REQ->FEAT) | IMPLEMENTED_BY (FEAT->TASK) | VERIFIED_BY (REQ|FEAT|TASK->TEST) | SHIPPED_IN (FEAT|TASK->DEPLOY)
  relation  String
  createdAt DateTime @default(now())

  @@unique([fromCode, toCode, relation])
  @@index([projectId])
}

model Proposal {
  id              String    @id @default(cuid())
  code            String    @unique // PROP-007
  leadId          String
  lead            Lead      @relation(fields: [leadId], references: [id])
  version         Int       @default(1)
  // DRAFT|SENT|CLARIFICATION_REQUESTED|APPROVED|REJECTED|SUPERSEDED
  status          String    @default("DRAFT")
  title           String
  problem         String
  solution        String
  scope           String    @default("[]") // JSON list
  outOfScope      String    @default("[]")
  deliverables    String    @default("[]")
  milestones      String    @default("[]") // JSON [{ name, weeks }]
  technology      String?
  priceTotal      Int       @default(0) // INR
  paymentSchedule String    @default("[]") // JSON [{ label, percent }], must sum to 100
  maintenance     String? // JSON { name, monthly, includes[] } or null
  assumptions     String    @default("[]")
  changePolicy    String
  validUntil      DateTime?
  // Internal economics: never rendered on the client page
  estHours        Int       @default(0)
  estCostHuman    Int       @default(0)
  estCostAi       Int       @default(0)
  estCostInfra    Int       @default(0)
  estCostOther    Int       @default(0)
  shareTokenHash  String?   @unique
  sentAt          DateTime?
  decidedAt       DateTime?
  decidedByName   String?
  clientNote      String?
  project         Project?  @relation("ProjectProposal")
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ChangeRequest {
  id            String    @id @default(cuid())
  code          String    @unique // CR-004
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  requestedBy   String
  description   String
  // null until assessed
  inScope       Boolean?
  impact        String?
  costDelta     Int       @default(0) // INR
  timelineDelta Int       @default(0) // days
  // OPEN|ASSESSED|APPROVED|REJECTED|CONVERTED
  status        String    @default("OPEN")
  taskId        String? // set when converted into normal work
  decidedBy     String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// One row per model call. The basis for AI cost governance.
model AiUsage {
  id           String   @id @default(cuid())
  task         String // e.g. "discovery"
  agentSlug    String?
  provider     String
  model        String
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float? // real when the provider reports it, else estimated, else null
  costSource   String // REPORTED|ESTIMATED|UNKNOWN
  latencyMs    Int
  success      Boolean
  error        String?
  leadId       String?
  projectId    String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------
// Phase 2: AI software factory
// ---------------------------------------------------------------------

// A structured, human-reviewed agent output that shapes the project: the
// Solution Architect's recommendation or the Planner's feature/task plan.
// Kept in the database (not /projects files) because it's client-specific.
model AgentRun {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id])
  // ARCHITECTURE | PLAN
  kind       String
  agentSlug  String
  // PROPOSED | ACCEPTED | REJECTED
  status     String    @default("PROPOSED")
  summary    String
  output     String // validated JSON (see src/lib/factory/*)
  usageId    String?
  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?
  createdAt  DateTime  @default(now())

  @@index([projectId, kind])
}
