<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{{ title | safe }}</title>
  <meta name="description" content="{{ description }}" />
  {% if nav == "home" %}<meta name="keywords" content="web development company, custom website development, web application development, backend development, custom software development, business website development, website developer, web development services" />{% endif %}
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://nirmaan.online{{ permalink }}" />

  <!-- Open Graph / Social -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://nirmaan.online{{ permalink }}" />
  <meta property="og:title" content="{{ title | safe }}" />
  <meta property="og:description" content="{{ ogDescription }}" />
  <meta property="og:image" content="https://nirmaan.online/og-image.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta property="og:site_name" content="Nirmaan" />
  <meta name="twitter:title" content="{{ title | safe }}" />
  <meta name="twitter:description" content="{{ ogDescription }}" />
  <meta name="twitter:image" content="https://nirmaan.online/og-image.jpg" />
  <meta name="theme-color" content="#080C14" />

  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%236366f1'/><text y='.9em' font-size='60' x='20'>N</text></svg>" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Shared styles -->
  <link rel="stylesheet" href="/styles.css" />
  <script src="/page-transitions.js"></script>
  {% if "tilt.js" in scripts %}<script src="/tilt.js" defer></script>{% endif %}
  {% if "contact-form.js" in scripts %}<script src="/contact-form.js" defer></script>{% endif %}
  {% if "layers-3d.js" in scripts %}<script src="/layers-3d.js" defer></script>{% endif %}
  {% if "device-switcher.js" in scripts %}<script src="/device-switcher.js" defer></script>{% endif %}

  <!-- Built with the Tailwind CLI (see tailwind.config.js). -->
  <link rel="stylesheet" href="/tailwind.css" />
</head>
<body class="bg-bg text-primary">

{% include "nav.njk" %}

<main id="main">
{{ content | safe }}
</main>

{% include "footer.njk" %}

<script src="/nav-interactions.js" defer></script>

</body>
</html>
