<nav id="navbar" class="fixed top-0 inset-x-0 z-50 border-b border-transparent">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="{{ nav == 'home' and '#home' or '/index.html' }}" class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-accent flex items-center justify-center flex-shrink-0"
             style="box-shadow:0 0 16px rgba(99,102,241,0.45);">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 4l5 3.5L13 4M3 8l5 3.5L13 8" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <span class="font-display font-extrabold text-primary text-[15px] tracking-tight">Nirmaan</span>
      </a>

      <!-- Desktop links -->
      <div class="hidden lg:flex items-center gap-7">
        {% for link in navLinks %}
        <a href="/{{ link.href }}" class="nav-link{{ ' active' if nav == link.slug }}">{{ link.label }}</a>
        {% endfor %}
      </div>

      <!-- Desktop CTA -->
      <a href="/contact.html" class="hidden lg:inline-flex btn-primary px-5 py-2.5 text-sm gap-2">
        Start Your Project
      </a>

      <!-- Hamburger -->
      <button id="hamburger" aria-label="Toggle menu" aria-expanded="false" class="lg:hidden flex flex-col gap-1.5 p-2">
        <span class="hamburger-line line-1"></span>
        <span class="hamburger-line line-2"></span>
        <span class="hamburger-line line-3"></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu — role="dialog"/aria-modal restored on every page (previously
       only index.html had it; the other five silently drifted without it). -->
  <div id="mobile-menu" class="lg:hidden absolute inset-x-0 top-16 glass border-b border-white/5" role="dialog" aria-modal="true">
    <div class="px-6 py-7 flex flex-col gap-5">
      {% for link in navLinks %}
      <a href="/{{ link.href }}" class="mobile-link {{ 'text-accent-light font-medium' if nav == link.slug else 'text-secondary font-medium hover:text-primary transition-colors' }}">{{ link.label }}</a>
      {% endfor %}
      <a href="/contact.html" class="mobile-link btn-primary px-5 py-3 text-sm text-center mt-1">Start Your Project</a>
    </div>
  </div>
</nav>
