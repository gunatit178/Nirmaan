<section class="section" aria-labelledby="honest-title">
  <div class="wrap split">
    <div class="split__copy" data-reveal>
      <p class="eyebrow">The honest version</p>
      <h2 class="section__title display" id="honest-title">A team of specialists. Not one model&nbsp;guessing.</h2>
      <p>“AI-built” usually means one model improvising a whole project in a single pass: no review, no specialisation, no way to catch a bad decision before it ships. That's the vibe-coded look, and it shows.</p>
      <p>Agency OS breaks a project into the roles a real studio has (product, design, architecture, engineering, QA) and routes work through each of them, with review built into every handoff.</p>
    </div>
    <ul class="roles" role="list" data-reveal style="--d: 1">
      {%- for r in roles %}
      <li>{% glyph r.glyph %}<h3>{{ r.title }}</h3><p>{{ r.text }}</p></li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section" id="pipeline" aria-labelledby="pipeline-title">
  <div class="wrap">
    <div class="section__head section__head--split" data-reveal>
      <div>
        <p class="eyebrow">The pipeline</p>
        <h2 class="section__title display" id="pipeline-title">Discovery to deployment, gated at every&nbsp;stage.</h2>
      </div>
      <p class="section__text">Five stages. Nothing crosses a gate until a person has reviewed it and said yes.</p>
    </div>

    <ol class="pipeline" role="list">
      {%- for st in stages %}
      <li data-reveal>
        <div class="stage">
          <p class="stage__num" aria-hidden="true">{{ loop.index }}</p>
          <div>
            <h3><span class="visually-hidden">Stage {{ loop.index }}: </span>{{ st.title }}</h3>
            <p>{{ st.text }}</p>
          </div>
        </div>
        {%- if st.gate %}
        <p class="gate">{% glyph "01110/01110/00100/11111/10101" %}<span>{{ st.gate }} · human sign-off</span></p>
        {%- endif %}
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section section--tight" aria-labelledby="proof-title">
  <div class="wrap">
    <div class="proof" data-reveal>
      <div>
        <p class="eyebrow">Not a pitch: a fact</p>
        <h2 class="proof__title display" id="proof-title">We run it on ourselves first.</h2>
        <p class="proof__text">Nirmaan's own agent roster ran a real review of Nirmaan's own marketing site. We don't ask clients to trust a system we haven't used on our own work.</p>
      </div>
      <ul class="proof__roster" role="list" aria-label="Agents in that review">
        {%- for r in roster %}<li>{{ r }}</li>{% endfor %}
      </ul>
    </div>
  </div>
</section>
