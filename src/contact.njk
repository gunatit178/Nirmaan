<script>
  // Interactive Estimator Logic
  function calculateEstimate() {
    const typeSelect = document.getElementById('est-type');
    const scaleSelect = document.getElementById('est-scale');
    const addons = document.querySelectorAll('.est-addon:checked');

    let basePrice = parseInt(typeSelect.value);
    let scale = parseFloat(scaleSelect.value);

    let addonPrice = 0;
    let extraWeeks = 0;
    addons.forEach(box => {
      addonPrice += parseInt(box.value);
      extraWeeks += parseInt(box.getAttribute('data-time'));
    });

    let totalMin = (basePrice * scale) + addonPrice;
    let totalMax = totalMin + (totalMin * 0.3); // 30% upper bound for range

    // Calculate timeline
    let baseTime = typeSelect.options[typeSelect.selectedIndex].getAttribute('data-time'); // e.g. "3-4 weeks"
    let timeMult = parseFloat(scaleSelect.options[scaleSelect.selectedIndex].getAttribute('data-time-mult'));

    let minWeeks = parseInt(baseTime.split('-')[0]) * timeMult + extraWeeks;
    let maxWeeks = parseInt(baseTime.split('-')[1].split(' ')[0]) * timeMult + extraWeeks;

    document.getElementById('est-price').innerText = `₹${Math.round(totalMin).toLocaleString('en-IN')} - ₹${Math.round(totalMax).toLocaleString('en-IN')}`;
    document.getElementById('est-timeline').innerText = `${Math.round(minWeeks)}-${Math.round(maxWeeks)} weeks`;
  }

  function applyEstimateToForm() {
    const typeSelect = document.getElementById('est-type');
    const typeText = typeSelect.options[typeSelect.selectedIndex].text;
    const estPrice = document.getElementById('est-price').innerText;
    const estTime = document.getElementById('est-timeline').innerText;

    let formType = document.getElementById('project-type');
    if(typeText.includes('Website')) formType.value = 'website';
    if(typeText.includes('E-Commerce')) formType.value = 'ecommerce';
    if(typeText.includes('Application')) formType.value = 'webapp';
    if(typeText.includes('Full-Stack')) formType.value = 'fullstack';

    let msg = document.getElementById('message');
    msg.value = `I used the project estimator:\n- Base: ${typeText}\n- Estimated Range: ${estPrice}\n- Estimated Timeline: ${estTime}\n\nAdditional details: `;

    const y = document.getElementById('main-contact-form').getBoundingClientRect().top + window.pageYOffset - 100;
    window.scrollTo({top: y, behavior: 'smooth'});
  }

  calculateEstimate();
</script>
