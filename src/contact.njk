---
layout: base.njk
title: "Contact — Nirmaan"
description: "Tell Nirmaan what you want to build. Get a ballpark budget and timeline instantly, then send an enquiry. We reply within 24 hours."
ogDescription: "Tell us what you want to build. Get a ballpark budget instantly, and a reply within 24 hours."
permalink: "/contact.html"
scripts: ["contact-form.js", "estimator.js"]
nav: "contact"
head:
  eyebrow: "Start a build"
  lines: ["Have an idea?", "Let's build it."]
  accent: 1
  lede: "Tell us what you need. Website, web application or a complete full-stack system, we'll help turn it into a working product."
  glyph: "00100/00010/11111/00010/00100"
  actions:
    - { label: "Estimate a budget first", href: "#estimator" }
types:
  - { value: "15000", weeks: "1-2", form: "website",   name: "Business website",  note: "Pages, forms, SEO" }
  - { value: "35000", weeks: "3-4", form: "ecommerce", name: "E-commerce store",  note: "Catalogue, payments, orders" }
  - { value: "60000", weeks: "4-6", form: "webapp",    name: "Web application",   note: "Accounts, logic, data" }
  - { value: "80000", weeks: "6-8", form: "fullstack", name: "Full-stack system", note: "Frontend + backend + database" }
scales:
  - { value: "1",   mult: "1",   name: "Simple",  note: "Standard features" }
  - { value: "1.5", mult: "1.5", name: "Medium",  note: "More pages, some custom logic" }
  - { value: "2.5", mult: "2",   name: "Complex", note: "Intricate logic, lots of data" }
addons:
  - { value: "10000", weeks: "1", name: "User login" }
  - { value: "15000", weeks: "2", name: "Admin dashboard" }
  - { value: "8000",  weeks: "1", name: "Payments" }
---
<section class="section" aria-label="Enquiry">
  <div class="wrap contact">

    <form class="form" id="enquiry" data-enquiry novalidate
          data-endpoint=""
          data-fallback-email="{{ site.email }}"
          aria-labelledby="enquiry-title">
      <div>
        <h2 class="form__title" id="enquiry-title">Tell us about your project</h2>
        <p class="form__intro">Fields marked <span class="accent" aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required. We reply within 24 hours.</p>
      </div>

      <div class="hp-field" aria-hidden="true">
        <label for="gotcha">Leave this empty</label>
        <input type="text" id="gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
      </div>

      <div class="form__row">
        <div class="field">
          <label for="name">Full name <span class="req" aria-hidden="true">*</span></label>
          <input class="input" type="text" id="name" name="name" required autocomplete="name" placeholder="Your name" />
        </div>
        <div class="field">
          <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
          <input class="input" type="email" id="email" name="email" required autocomplete="email" inputmode="email" placeholder="you@company.com" />
        </div>
      </div>

      <div class="form__row">
        <div class="field">
          <label for="phone">Phone <span class="opt">(optional)</span></label>
          <input class="input" type="tel" id="phone" name="phone" autocomplete="tel" inputmode="tel" placeholder="+91 98xxx xxxxx" />
        </div>
        <div class="field">
          <label for="company">Company <span class="opt">(optional)</span></label>
          <input class="input" type="text" id="company" name="company" autocomplete="organization" placeholder="Company or organisation" />
        </div>
      </div>

      <div class="field">
        <label for="project">What do you want to build? <span class="req" aria-hidden="true">*</span></label>
        <input class="input" type="text" id="project" name="project" required placeholder="e.g. An online store for my clothing brand, a booking system for my salon…" />
      </div>

      <div class="form__row">
        <div class="field">
          <label for="project-type">Project type</label>
          <select class="input" id="project-type" name="project_type">
            <option value="">Choose one</option>
            <option value="website">Business website</option>
            <option value="ecommerce">E-commerce website</option>
            <option value="webapp">Web application</option>
            <option value="backend">Backend / API development</option>
            <option value="fullstack">Full-stack (website + backend)</option>
            <option value="dashboard">Admin panel / dashboard</option>
            <option value="redesign">Website redesign</option>
            <option value="maintenance">Maintenance &amp; support</option>
            <option value="other">Other / not sure yet</option>
          </select>
        </div>
        <div class="field">
          <label for="budget">Budget</label>
          <select class="input" id="budget" name="budget">
            <option value="">Choose a range</option>
            <option value="under-25k">Under ₹25,000</option>
            <option value="25k-75k">₹25,000 – ₹75,000</option>
            <option value="75k-2l">₹75,000 – ₹2,00,000</option>
            <option value="2l-5l">₹2,00,000 – ₹5,00,000</option>
            <option value="5l-plus">₹5,00,000+</option>
            <option value="unsure">Not sure yet</option>
          </select>
        </div>
      </div>

      <div class="field">
        <label for="timeline">When do you need it?</label>
        <select class="input" id="timeline" name="timeline">
          <option value="">Choose a timeline</option>
          <option value="asap">As soon as possible</option>
          <option value="1-month">Within 1 month</option>
          <option value="3-months">Within 3 months</option>
          <option value="flexible">Flexible / no deadline</option>
        </select>
      </div>

      <div class="field">
        <label for="message">Anything else? <span class="opt">(optional)</span></label>
        <textarea class="input" id="message" name="message" rows="5" placeholder="Requirements, links, questions: anything that helps us understand the project."></textarea>
      </div>

      <div class="notice notice--ok" data-form-ok role="status" tabindex="-1" hidden>
        <b>Enquiry sent.</b>
        <span>Thanks. We'll reply within 24 hours.</span>
      </div>
      <div class="notice notice--error" data-form-error role="alert" hidden>
        <b>Not sent.</b>
        <span data-form-error-text></span>
      </div>

      <div class="form__submit">
        <button class="btn" type="submit"><span data-label>Send enquiry</span> {% glyph "00100/00010/11111/00010/00100", "btn__arrow" %}</button>
        <p class="form__note">No spam, no mailing lists. We only use this to reply.</p>
      </div>
    </form>

    <aside class="contact__aside" aria-label="What to expect">
      <div data-reveal>
        <p class="eyebrow">What happens next</p>
        <ol class="next-steps" role="list">
          <li><b>You send your enquiry</b><span>As much or as little detail as you have.</span></li>
          <li><b>We review and reply</b><span>Within 24 hours, with first thoughts and any questions.</span></li>
          <li><b>A short discovery call</b><span>Call or WhatsApp, to understand the project before recommending anything.</span></li>
          <li><b>Proposal &amp; estimate</b><span>Clear scope, timeline and cost. No hidden surprises.</span></li>
        </ol>
      </div>

      {%- if site.email or site.phone or site.whatsapp %}
      <div data-reveal>
        <p class="eyebrow">Or reach us directly</p>
        <div class="channels">
          {%- if site.email %}<a class="channel" href="mailto:{{ site.email }}"><span class="mono">Email</span><b>{{ site.email }}</b></a>{% endif %}
          {%- if site.phone %}<a class="channel" href="tel:{{ site.phone | replace(' ', '') }}"><span class="mono">Phone</span><b>{{ site.phone }}</b></a>{% endif %}
          {%- if site.whatsapp %}<a class="channel" href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener noreferrer"><span class="mono">WhatsApp</span><b>Message us <span aria-hidden="true">↗</span></b></a>{% endif %}
        </div>
      </div>
      {%- endif %}

      <div data-reveal>
        <p class="eyebrow">Recent client</p>
        <a class="channel" href="/projects.html"><span class="mono">Sudaangeo.in</span><b>Website + automation →</b></a>
      </div>
    </aside>
  </div>
</section>

<section class="section" id="estimator" aria-labelledby="estimator-title">
  <div class="wrap">
    <div class="section__head section__head--split" data-reveal>
      <div>
        <p class="eyebrow">Project estimator</p>
        <h2 class="section__title display" id="estimator-title">Ballpark it in ten&nbsp;seconds.</h2>
      </div>
      <p class="section__text">Pick what's closest. It's a starting range, not a quote. Your real proposal comes after we've talked.</p>
    </div>

    <form class="estimator" data-estimator aria-label="Project estimator">
      <div class="estimator__inputs">
        <fieldset>
          <legend>Project type</legend>
          <div class="choice-grid">
            {%- for t in types %}
            <label class="choice">
              <input type="radio" name="est-type" value="{{ t.value }}" data-weeks="{{ t.weeks }}" data-form-value="{{ t.form }}"{% if loop.first %} checked{% endif %} />
              <span class="choice__box"><b>{{ t.name }}</b><span>{{ t.note }}</span></span>
            </label>
            {%- endfor %}
          </div>
        </fieldset>

        <fieldset>
          <legend>Complexity</legend>
          <div class="choice-grid choice-grid--3">
            {%- for sc in scales %}
            <label class="choice">
              <input type="radio" name="est-scale" value="{{ sc.value }}" data-time-mult="{{ sc.mult }}"{% if loop.first %} checked{% endif %} />
              <span class="choice__box"><b>{{ sc.name }}</b><span>{{ sc.note }}</span></span>
            </label>
            {%- endfor %}
          </div>
        </fieldset>

        <fieldset>
          <legend>Add-ons</legend>
          <div class="chip-row">
            {%- for a in addons %}
            <label class="choice chip">
              <input type="checkbox" name="est-addon" value="{{ a.value }}" data-weeks="{{ a.weeks }}" />
              <span class="choice__box"><b>{{ a.name }}</b></span>
            </label>
            {%- endfor %}
          </div>
        </fieldset>
      </div>

      <div class="estimator__result" aria-live="polite">
        <p class="mono">Estimated range</p>
        <p class="estimator__price" data-est-price>₹15,000 – ₹19,500</p>
        <div>
          <p class="mono">Timeline · <span class="estimator__weeks" data-est-weeks>1–2 weeks</span></p>
          <div class="weeks" data-est-bar role="img" aria-label="Timeline: 1–2 weeks"><i></i><i class="is-range"></i></div>
          <p class="weeks-legend"><span>1 block = 1 week</span><span>Possible extra time</span></p>
        </div>
        <button class="btn btn--inverse" type="submit">Use this estimate {% glyph "00100/00010/11111/00010/00100", "btn__arrow" %}</button>
        <p class="estimator__fine">Adds your choices to the enquiry form above. Final pricing depends on scope, content and integrations.</p>
      </div>
    </form>
  </div>
</section>
