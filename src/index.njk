     CONTACT
================================================================ -->
<section id="contact" class="py-12 lg:py-16 relative">
  <div class="orb" style="width:500px;height:500px;background:radial-gradient(circle,rgba(99,102,241,0.07) 0%,transparent 70%);bottom:-150px;right:-150px;"></div>
  <div class="s-line mb-8 max-w-7xl mx-auto px-5 sm:px-8 lg:px-10"></div>

  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 relative z-10">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start">

      <!-- Left: 5 cols -->
      <div class="lg:col-span-5 reveal">
        <p class="text-muted text-xs font-semibold uppercase tracking-widest mb-2">Get in Touch</p>
        <h2 class="font-display font-extrabold text-primary leading-tight mb-3 text-2xl sm:text-3xl lg:text-4xl">
          Have an idea?<br /><span class="gradient-text">Let's build it.</span>
        </h2>
        <p class="text-secondary text-xs sm:text-sm leading-relaxed mb-6">
          Tell us what you need. We'll help turn your idea into a working, high-performance digital product.
        </p>

        <div class="space-y-3">

          <a href="mailto:[YOUR-EMAIL@DOMAIN.COM]" class="flex items-center gap-3 p-3 glass rounded-xl hover:border-accent/25 transition-all group border border-white/5">
            <div class="w-8 h-8 rounded-lg bg-accent/10 border border-accent/18 flex items-center justify-center flex-shrink-0">
              <svg width="15" height="15" viewBox="0 0 18 18" fill="none"><rect x="2" y="4" width="14" height="10" rx="2" stroke="#818cf8" stroke-width="1.4"/><path d="M2 7l7 4 7-4" stroke="#818cf8" stroke-width="1.4" stroke-linecap="round"/></svg>
            </div>
            <div>
              <p class="text-muted text-[10px] mb-0.5">Email</p>
              <p class="text-primary text-xs font-medium group-hover:text-accent-light transition-colors">[YOUR-EMAIL@DOMAIN.COM]</p>
            </div>
          </a>

          <a href="tel:[YOUR-PHONE]" class="flex items-center gap-3 p-3 glass rounded-xl hover:border-accent/25 transition-all group border border-white/5">
            <div class="w-8 h-8 rounded-lg bg-accent/10 border border-accent/18 flex items-center justify-center flex-shrink-0">
              <svg width="15" height="15" viewBox="0 0 18 18" fill="none"><path d="M3 3h4l1.5 4-2 1.5c1 2 2.5 3.5 4.5 4.5L12.5 11l4 1.5V16c-8 .5-14-6.5-13.5-13z" stroke="#818cf8" stroke-width="1.4" stroke-linejoin="round"/></svg>
            </div>
            <div>
              <p class="text-muted text-[10px] mb-0.5">Phone</p>
              <p class="text-primary text-xs font-medium group-hover:text-accent-light transition-colors">[YOUR-PHONE-NUMBER]</p>
            </div>
          </a>

          <a href="https://wa.me/[WHATSAPP-NUMBER]" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-3 glass rounded-xl hover:border-emerald-500/25 transition-all group border border-white/5">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/18 flex items-center justify-center flex-shrink-0">
              <svg width="15" height="15" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="7" stroke="#34d399" stroke-width="1.4"/><path d="M6 9.5c.5 1.5 2 2.5 3.5 2.5.7 0 1.3-.2 1.8-.5l1.7.5-.5-1.7C12.8 9.8 13 9.2 13 8.5 13 6.6 11.2 5 9 5S5 6.6 5 8.5c0 .5.1 1 .3 1.4L5 12l2.1-.5" stroke="#34d399" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <div>
              <p class="text-muted text-[10px] mb-0.5">WhatsApp</p>
              <p class="text-primary text-xs font-medium group-hover:text-emerald-400 transition-colors">Message on WhatsApp</p>
            </div>
          </a>

        </div>
      </div>

      <!-- Right: Form (7 cols) -->
      <div class="lg:col-span-7 reveal rd2">
        <form id="contact-form" class="glass rounded-xl p-6 sm:p-7 border border-white/6 space-y-3.5" onsubmit="handleFormSubmit(event)" novalidate data-endpoint="">
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" hidden />

          <div class="grid sm:grid-cols-2 gap-3.5">
            <div>
              <label for="name" class="block text-secondary text-[11px] font-medium mb-1">Full Name <span class="text-accent">*</span></label>
              <input type="text" id="name" name="name" class="form-field" placeholder="Your full name" required autocomplete="name" />
            </div>
            <div>
              <label for="email" class="block text-secondary text-[11px] font-medium mb-1">Email Address <span class="text-accent">*</span></label>
              <input type="email" id="email" name="email" class="form-field" placeholder="your@email.com" required autocomplete="email" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-3.5">
            <div>
              <label for="phone" class="block text-secondary text-[11px] font-medium mb-1">Phone Number</label>
              <input type="tel" id="phone" name="phone" class="form-field" placeholder="+91 00000 00000" autocomplete="tel" />
            </div>
            <div>
              <label for="company" class="block text-secondary text-[11px] font-medium mb-1">Company / Organization</label>
              <input type="text" id="company" name="company" class="form-field" placeholder="Your company name" autocomplete="organization" />
            </div>
          </div>

          <div>
            <label for="project" class="block text-secondary text-[11px] font-medium mb-1">What do you want to build? <span class="text-accent">*</span></label>
            <input type="text" id="project" name="project" class="form-field" placeholder="e.g. E-commerce website, web app, backend API..." required />
          </div>

          <div>
            <label for="budget" class="block text-secondary text-[11px] font-medium mb-1">Budget Range</label>
            <select id="budget" name="budget" class="form-field">
              <option value="">Select a budget range</option>
              <option value="under-25k">Under ₹25,000</option>
              <option value="25k-75k">₹25,000 – ₹75,000</option>
              <option value="75k-2l">₹75,000 – ₹2,00,000</option>
              <option value="2l-5l">₹2,00,000 – ₹5,00,000</option>
              <option value="5l+">₹5,00,000+</option>
              <option value="not-sure">Not sure yet</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-secondary text-[11px] font-medium mb-1">Additional Details</label>
            <textarea id="message" name="message" rows="3" class="form-field resize-none" placeholder="Tell us more about your project, timeline, any specific requirements..."></textarea>
          </div>

          <button type="submit" id="submit-btn" class="btn-primary w-full py-3 text-sm font-semibold gap-2">
            <span id="submit-text">Start My Project</span>
            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <div id="form-success" class="hidden text-center py-1">
            <p class="text-emerald-400 text-xs font-medium">✓ Message sent! We'll get back to you soon.</p>
          </div>
          <div id="form-error" class="hidden text-center py-1">
            <p class="text-rose-400 text-xs font-medium">Please fill in the required fields (Name, Email, Project).</p>
          </div>

        </form>
      </div>

    </div>
  </div>
</section>
