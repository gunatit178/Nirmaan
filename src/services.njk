---
layout: base.njk
title: "Services — Nirmaan"
description: "Custom website development, web applications, backend systems, APIs, databases, e-commerce, dashboards and automation. Every service Nirmaan offers, in detail."
ogDescription: "From custom websites to full-stack web applications: every service we offer, in detail."
permalink: "/services.html"
nav: "services"
head:
  eyebrow: "What we build"
  lines: ["From idea to", "working product."]
  accent: 1
  lede: "A simple business website or a full-stack application with its own backend: we design, build and support the whole thing, start to finish."
  glyph: "11011/11011/00000/11011/11011"
  actions:
    - { label: "Get an estimate", href: "/contact.html#estimator", style: "primary" }
    - { label: "See our work", href: "/projects.html" }
cta:
  eyebrow: "Not sure which you need?"
  lines: ["Tell us the problem.", "We'll pick the tools."]
  text: "Describe what you want to build. We'll recommend the right approach and give you an honest estimate before any work starts."
  primary: { label: "Discuss your project", href: "/contact.html" }
  secondary: { label: "Try the estimator", href: "/contact.html#estimator" }
includes:
  - { title: "Mobile-first", text: "Designed for phones first, then scaled up to tablets and desktops." }
  - { title: "Search-ready", text: "Clean structure, metadata and speed that search engines reward." }
  - { title: "Yours to keep", text: "Once paid for, you own the code, the database and every asset." }
  - { title: "Supported", text: "Maintenance, fixes and improvements after launch, on request." }
---
<section class="section" aria-label="Services">
  <div class="wrap">
    {%- for group in services.groups %}
    <div class="svc-group" id="{{ group.id }}">
      <header class="svc-group__head" data-reveal>
        <p class="eyebrow">{{ group.items | length }} services</p>
        <h2 class="svc-group__title display">{{ group.label }}</h2>
        <p class="svc-group__summary">{{ group.summary }}</p>
      </header>

      <div class="svc-list">
        {%- for item in group.items %}
        <article class="svc-row" id="{{ item.id }}" data-reveal aria-labelledby="{{ item.id }}-title">
          {% glyph item.glyph, "svc-row__glyph" %}
          <div>
            <h3 class="svc-row__title" id="{{ item.id }}-title">{{ item.title }}</h3>
            <p class="svc-row__text">{{ item.text }}</p>
          </div>
          <ul class="ticks" role="list" aria-label="Includes">
            {%- for f in item.features %}<li>{{ f }}</li>{% endfor %}
          </ul>
        </article>
        {%- endfor %}
      </div>
    </div>
    {%- endfor %}
  </div>
</section>

<section class="section section--tight" aria-labelledby="includes-title">
  <div class="wrap">
    <div class="section__head section__head--split" data-reveal>
      <div>
        <p class="eyebrow">In every build</p>
        <h2 class="section__title display" id="includes-title">The parts you don't have to ask&nbsp;for.</h2>
      </div>
      <p class="section__text">Whatever the service, these come as standard. They aren't upsells.</p>
    </div>
    <ul class="includes" role="list">
      {%- for i in includes %}
      <li data-reveal style="--d: {{ loop.index0 }}"><b>{{ i.title }}</b><span>{{ i.text }}</span></li>
      {%- endfor %}
    </ul>
  </div>
</section>
